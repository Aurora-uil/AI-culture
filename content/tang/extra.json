  "fixed_cards": [
    {
      "id": "card_why_wencheng_not_in_artwork",
      "title": "为什么文成公主不在画里？",
      "trigger_button_label": "为什么文成公主不在画里？",
      "body_text": "《步辇图》描绘的核心场景是唐太宗接见吐蕃使臣禄东赞。文成公主是与这次唐蕃婚姻事件相关的重要历史人物，但不是画面中被描绘的核心人物。因此平台通过「禄东赞 → 历史事件 → 文成公主」展开她，而不是在画中人为增加不存在的热点。",
      "buttons": [
        { "id": "BTN-T03-04-A", "label": "查看故宫资料", "action": "open_source", "target": "src_dpm_bunian_collection" },
        { "id": "BTN-T03-04-B", "label": "查看相关事件", "action": "open_entity", "target": "event_tang_tubo_marriage_641" }
      ],
      "related_entity_ids": ["person_princess_wencheng", "person_ludongzan", "event_tang_tubo_marriage_641"],
      "source_ids": ["src_dpm_bunian_collection", "src_dpm_minghuaji_bunian"],
      "review_status": "approved",
      "note": "文案照抄规格文档 §9.4 固定知识卡，属固定内容，不使用 LLM 实时生成。"
    },
    {
      "id": "card_artwork_evidence_boundary",
      "title": "这幅画能证明什么、不能证明什么",
      "trigger_button_label": "阅读图像证据边界",
      "body_text": "历史画是理解历史的重要图像材料，但画面表现、艺术创作和历史现场之间不能简单画等号。具体历史事实需要与文献和其他材料互相核验。",
      "four_step": [
        "画面能直接观察什么",
        "博物馆资料如何说明",
        "其他文献能确认什么",
        "画面不能直接证明什么"
      ],
      "source_ids": ["src_dpm_bunian_collection"],
      "review_status": "approved",
      "note": "文案照抄规格文档 §2.4 固定提示，属固定内容。"
    },
    {
      "id": "card_attribution_note",
      "title": "关于作者归属的说明",
      "trigger_button_label": "查看归属说明",
      "body_text": "故宫博物院藏品页现行编目为「《步辇图》卷，唐，阎立本作」。故宫名画记资料同时指出，本幅无画家款印，该作归于阎立本的重要依据是北宋章伯益的篆书题识「唐相阎立本笔」。相关研究史对作者归属、是否为原作或后世摹本等问题存在讨论。本平台展示博物馆现行编目，同时如实告知存在不同研究观点，不自行裁定学术争论。",
      "four_items_must_appear": [
        "故宫现行编目为阎立本作",
        "本幅无画家款印",
        "北宋章伯益篆书题「唐相阎立本笔」",
        "研究史存在相关讨论"
      ],
      "source_ids": ["src_dpm_bunian_collection", "src_dpm_minghuaji_bunian", "src_dpm_yuankan_xie_2018"],
      "review_status": "approved",
      "note": "文案依据规格文档 §2.3 与 §10.1 编写；AI 回答作者问题时必须同时保留上述四项信息。"
    }
  ],

