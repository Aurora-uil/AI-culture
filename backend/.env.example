# ============================================================
# 《同心千年》后端配置
# 复制本文件为 .env 后按需修改。.env 已在 .gitignore 中，不会入库。
# ============================================================

# ---------- 数据库 ----------
# 注意端口是 5433，不是 5432（5432 已被本机另一个项目占用）
DATABASE_URL=postgresql+psycopg://tongxin:tongxin_dev@localhost:5433/tongxin

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tongxin_dev
NEO4J_DATABASE=neo4j

# ---------- LLM ----------
# 留空 LLM_API_KEY 时，系统自动进入「演示保障模式」：
# 由 fallback_faq 预审核问答库作答，界面会明确标注，不会伪装成实时 AI。
#
# LLM_PROVIDER 可选值：
#   openai_compatible —— DeepSeek / 通义千问 / 豆包 / Kimi / 智谱 等
#   anthropic         —— Claude
#   mock              —— 强制使用兜底问答库（调试用）
LLM_PROVIDER=openai_compatible

# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 通义千问示例（兼容模式）：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# Anthropic 示例：
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200

# ---------- Embedding ----------
# 留空时使用本地中文检索（字符 bigram TF-IDF + BM25 混合），无需任何外部依赖。
# 填写后切换到向量检索。语料仅数百条，两种方式都很快。
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ---------- 图像生成（当代章节 AI 共创） ----------
# 留空时 /cocreation/jobs 返回预置演示样例（is_fallback_sample=true），
# 界面固定标注「AI辅助文化创意作品 · 非传统羌绣原作」，不伪装成实时生成。
IMAGE_PROVIDER=none
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ---------- 检索参数 ----------
RETRIEVAL_TOP_K=12
RETRIEVAL_FINAL_K=5
# 相似度阈值不要跨模型硬编码，应在自己的验证集上标定（见各章 §14.3）
RETRIEVAL_MIN_SCORE=0.18

# ---------- 服务 ----------
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
